-- ⚡ DURATION: 120 seconds (2 minutes)
local TOTAL_DURATION = 120

local function startProgressBar()
    local tweenInfo = TweenInfo.new(TOTAL_DURATION, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local goal = { Size = UDim2.new(1, 0, 1, 0) }
    local tween = TweenService:Create(ProgressFill, tweenInfo, goal)
    tween:Play()
    while tween.PlaybackState ~= Enum.PlaybackState.Completed do
        local percent = ProgressFill.Size.X.Scale
        ProgressText.Text = math.floor(percent * 100) .. "%"
        task.wait(0.5)
    end
    ProgressText.Text = "100%"
end

local function startStatusCycle()
    local index = 0
    while LoadingGui and LoadingGui.Parent do
        task.wait(10)
        index = index + 1
        if index > #statusMessages then index = 1 end
        StatusText.Text = statusMessages[index]
        local fade = TweenService:Create(StatusText,
            TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {TextTransparency = 0}
        )
        fade:Play()
    end
end

local function pulseGlow()
    if not LoadingGui or not LoadingGui.Parent then return end
    local pulse = TweenService:Create(GlowBorder,
        TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {BackgroundTransparency = 0.3}
    )
    pulse:Play()
end

-- Start loading sequence (never ends)
task.spawn(function()
    startProgressBar()
    startStatusCycle()
    pulseGlow()
    task.wait(TOTAL_DURATION + 2)
    if LoadingGui and LoadingGui.Parent then
        StatusText.Text = "✅ Script loaded successfully!"
        StatusText.TextColor3 = Color3.fromRGB(100, 255, 100)
        ProgressText.Text = "100%"
    end
    task.wait(9e9)  -- stay forever
end)
