jobLabel.Parent = frame

-- Job ID text box
local jobBox = Instance.new("TextBox")
jobBox.Size = UDim2.new(0.5, 0, 0, 30)
jobBox.Position = UDim2.new(0.45, 0, 0.50, 0)
jobBox.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
jobBox.TextColor3 = Color3.fromRGB(255, 255, 255)
jobBox.Font = Enum.Font.Gotham
