-- Join button
local joinButton = Instance.new("TextButton")
joinButton.Size = UDim2.new(0.6, 0, 0, 40)
joinButton.Position = UDim2.new(0.2, 0, 0.75, 0)
joinButton.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
joinButton.TextColor3 = Color3.fromRGB(255, 255, 255)
joinButton.Font = Enum.Font.GothamBold
joinButton.TextSize = 18
joinButton.Text = "🚀 Join Server"
joinButton.Parent = frame
local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent = joinButton

-- Hover effect
joinButton.MouseEnter:Connect(function()
    joinButton.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
end)
joinButton.MouseLeave:Connect(function()
    joinButton.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
end)

-- Join function
joinButton.MouseButton1Click:Connect(function()
    local placeId = tonumber(placeBox.Text)
    local jobId = jobBox.Text:match("^%s*(.-)%s*$")  -- trim whitespace

    if not placeId then
        joinButton.Text = "❌ Invalid Place ID"
        task.wait(1)
        joinButton.Text = "🚀 Join Server"
        return
    end

    if jobId == "" or #jobId < 10 then
        joinButton.Text = "❌ Invalid Job ID"
        task.wait(1)
        joinButton.Text = "🚀 Join Server"
        return
    end

    -- Attempt teleport
    joinButton.Text = "⏳ Teleporting..."
    joinButton.BackgroundColor3 = Color3.fromRGB(255, 200, 50)

    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
    end)

    if not success then
        joinButton.Text = "❌ Failed: " .. tostring(err)
        joinButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        task.wait(2)
        joinButton.Text = "🚀 Join Server"
        joinButton.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
    else
        -- If teleport succeeds, the script will be terminated anyway.
    end
end)

print("✅ JobID Joiner loaded. Open the GUI and enter Place ID + Job ID.")
