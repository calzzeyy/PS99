-- ================================================
--  JOIN FUNCTION
-- ================================================
joinButton.MouseButton1Click:Connect(function()
    local placeId = tonumber(placeBox.Text)
    local jobId = jobBox.Text:match("^%s*(.-)%s*$")
    
    if not placeId then
        statusText.Text = "❌ Invalid Place ID"
        statusText.TextColor3 = Color3.fromRGB(255, 80, 80)
        joinButton.Text = "⚠️ Invalid"
        task.wait(1.5)
        statusText.Text = ""
        joinButton.Text = "🚀 Join Server"
        return
    end
    
    if jobId == "" or #jobId < 10 then
        statusText.Text = "❌ Invalid Job ID"
        statusText.TextColor3 = Color3.fromRGB(255, 80, 80)
        joinButton.Text = "⚠️ Invalid"
        task.wait(1.5)
        statusText.Text = ""
        joinButton.Text = "🚀 Join Server"
        return
    end
    
    statusText.Text = "⏳ Teleporting to server..."
    statusText.TextColor3 = Color3.fromRGB(255, 200, 50)
    joinButton.Text = "⏳ Joining..."
    joinButton.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
    
    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
    end)
    
    if not success then
        statusText.Text = "❌ Failed: " .. tostring(err)
        statusText.TextColor3 = Color3.fromRGB(255, 80, 80)
        joinButton.Text = "❌ Failed"
        joinButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        task.wait(2)
        statusText.Text = ""
        joinButton.Text = "🚀 Join Server"
        joinButton.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
    end
end)

